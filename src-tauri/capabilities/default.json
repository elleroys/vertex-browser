{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "vortex-main-ui-capability",
  "description": "Привілеї IPC надаються ВИКЛЮЧНО головному інтерфейсу Vortex (main). Зовнішні сайти у вкладках tab-* повністю ізольовані від команд Tauri.",
  "webviews": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-is-fullscreen",
    "core:window:allow-set-fullscreen",
    "core:window:allow-close",
    "dialog:allow-open",
    "dialog:allow-save",
    "shell:allow-open"
  ]
}
